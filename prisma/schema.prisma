datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String @id
  email        String @unique
  passwordHash String
  updatedAt    String

  @@map("admin_users")
}

model Product {
  id                String      @id
  name              String
  slug              String      @unique
  description       String      @db.Text
  shortDescription  String      @db.Text
  price             Float
  compareAtPrice    Float?
  category          String
  categories        Json?
  brand             String      @default("Al-Mu'attar")
  size              String      @default("50ml")
  fragranceType     String
  gender            String
  notes             Json
  images            Json
  stock             Int         @default(0)
  sku               String      @default("")
  isFeatured        Boolean     @default(false)
  isBestseller      Boolean     @default(false)
  is_bestseller     Boolean     @default(false)
  isActive          Boolean     @default(true)
  isFreeShipping    Boolean     @default(false)
  customShippingFee Float?
  createdAt         String
  updatedAt         String

  orderItems        OrderItem[]

  @@index([category])
  @@index([gender])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

model Customer {
  id            String   @id
  fullName      String
  email         String   @unique
  phone         String
  city          String   @default("")
  totalOrders   Int      @default(0)
  totalSpent    Float    @default(0)
  lastOrderDate String
  createdAt     String

  orders        Order[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model Order {
  id                 String      @id
  orderNumber        String      @unique
  customerId         String?
  customer           Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerFullName   String
  customerEmail      String
  customerPhone      String
  shippingFullName   String
  shippingPhone      String
  shippingEmail      String
  shippingAddress    String      @db.Text
  shippingCity       String
  shippingPostalCode String?
  shippingOrderNotes String?     @db.Text
  subtotal           Float
  shippingFee        Float       @default(0)
  totalAmount        Float
  paymentMethod      String      @default("Cash on Delivery")
  paymentStatus      String      @default("Pending")
  orderStatus        String      @default("Pending")
  statusHistory      Json
  rawItemsJson       Json?
  createdAt          String
  updatedAt          String

  items              OrderItem[]

  @@index([orderStatus])
  @@index([customerEmail])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String   @db.Text
  size         String   @default("")
  quantity     Int
  price        Float
  subtotal     Float

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model ContactMessage {
  id        String  @id
  fullName  String
  email     String
  phone     String  @default("")
  subject   String  @default("General Inquiry")
  message   String  @db.Text
  isRead    Boolean @default(false)
  createdAt String

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id           String @id
  email        String @unique
  subscribedAt String

  @@map("newsletter_subscribers")
}

model StoreSettings {
  id        String @id @default("primary_settings")
  key       String @unique @default("primary_settings")
  settings  Json
  updatedAt String

  @@map("store_settings")
}

model MigrationMarker {
  id           String @id @default("initial_database_json_migration_v1")
  migrationKey String @unique
  migratedAt   String
  recordCounts Json
  sourceFile   String
  status       String
  version      String @default("1.0.0")

  @@map("migration_markers")
}
